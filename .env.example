# ==============================================================================
# Campus Infrastructure Fault Reporting System - Environment Variables
# Copy this file to .env and fill in your values for local or cloud deployment.
# ==============================================================================

# Server Port (Render sets this dynamically via $PORT)
PORT=8080

# Application Context Path (Use / for root domain or /campus-fault-system for subpath)
CONTEXT_PATH=/campus-fault-system

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campus_fault_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# File Upload Directory
UPLOAD_DIRECTORY=uploads
